      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "PROVENANCE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js",
    "demo": "node demo/server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YAMADA-Ryosuke-0114/web-media-controls.git"
  },
